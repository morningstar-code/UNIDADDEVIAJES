// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  RI_DIRECTORA
  VIAJES_ANALISTA
  DESPACHO
  CONSEJO_DIRECTIVO
  JEFE
  FINANZAS
  RRHH
}

enum CaseSource {
  EMAIL_AUTOMATION
  EMAIL_AUTHORIZATION
  MANUAL
  PUBLIC_FORM
  MATRIZ
  DESIGNATION
  AUTHORIZATION_MEMO
  DIRECT_INSTRUCTION
}

enum CaseStatus {
  PENDIENTE_CLASIFICACION
  AUTORIZACION_RECIBIDA
  PENDIENTE_VALIDACION_AMPARO
  VALIDADO_POR_AMPARO
  DEVUELTO_POR_AMPARO
  RECHAZADO_POR_AMPARO
  INSTRUCCION_RECIBIDA
  SIN_MEMORANDO_JUSTIFICADO
  VIAJE_IMPREVISTO
  FUERA_PLAZO_MAPRE
  PENDIENTE_DESIGNACION
  MATRIZ_REGISTRADA
  PENDIENTE_PAUTA_RI
  PAUTA_RI_DADA
  DESIGNACION_BORRADOR
  DESIGNACION_GENERADA
  DESIGNACION_ENVIADA
  PENDIENTE_ACEPTACION_COLABORADOR
  COLABORADOR_ACEPTO
  COLABORADOR_RECHAZO
  PENDIENTE_DOCUMENTOS
  DOCUMENTOS_EN_REVISION
  DOCUMENTOS_COMPLETOS
  FORMULARIO_EN_ELABORACION
  CARTA_EN_ELABORACION
  EXPEDIENTE_ARMADO
  ENVIADO_MAPRE
  DESPACHO_REVIEW
  CONSEJO_DIRECTIVO_FIRMA
  EXPEDIENTE_FIRMADO_RECIBIDO
  COORDINACION_ADMINISTRATIVA
  VIAJE_REALIZADO
  PENDIENTE_INFORME_Y_LIQUIDACION
  PENDIENTE_LIQUIDACION
  LIQUIDACION_EN_REVISION
  LIQUIDACION_REQUIERE_CORRECCION
  LIQUIDACION_APROBADA
  NO_APLICA_LIQUIDACION
  CANCELLED
  FIRMA_DIGITAL_PENDIENTE_JUSTIFICACION
  RECEIVED
  DOCS_VALIDATION
  TECH_REVIEW
  MANAGER_APPROVAL
  FINANCE_APPROVAL
  HR_APPROVAL
  APPROVED
  REJECTED
  NEEDS_INFO
  CLOSED
}

enum WorkflowStep {
  AUTHORIZATION_VALIDATION
  AUTHORIZATION_CORRECTION
  PENDIENTE_PAUTA_RI
  DESIGNATION
  COLLABORATOR_ACCEPTANCE
  DOCUMENT_COLLECTION
  DOCUMENT_REVIEW
  FORMULARIO_SOLICITUD
  CARTA_MINISTRO
  EXPEDIENTE_REVIEW
  DESPACHO_REVIEW
  CONSEJO_DIRECTIVO_FIRMA
  EXPEDIENTE_FIRMADO_RECEIPT
  COORDINACION_ADMINISTRATIVA
  POST_TRAVEL
  LIQUIDATION_REVIEW
  CLOSURE
  DOCS_VALIDATION
  TECH_REVIEW
  MANAGER_APPROVAL
  FINANCE_APPROVAL
  HR_APPROVAL
}

enum TaskStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum DocumentType {
  MEMORANDO_AUTORIZACION_PRESIDENCIA
  EVIDENCIA_INSTRUCCION_DIRECTA
  CORREO_INSTRUCCION
  CORREO_DESIGNACION
  ACEPTACION_COLABORADOR
  CEDULA
  PASAPORTE
  VISA
  FOTO
  CARTA_INVITACION
  INVITACION
  AGENDA
  TICKET
  MEMO_APROBACION
  FORMULARIO_SOLICITUD_VIAJE
  FORMULARIO_SOLICITUD_VIAJE_EXTERIOR
  CARTA_MAPRE
  CARTA_MINISTRO_ADMINISTRATIVO
  EXPEDIENTE_FIRMADO
  JUSTIFICACION_FIRMA_DIGITAL
  FORMULARIO_LIQUIDACION_INFORMATIVO
  FORMULARIO_LIQUIDACION_GENERADO
  FORMULARIO_LIQUIDACION_COMPLETADO
  FACTURAS_LIQUIDACION
  VOLANTE_DEPOSITO_REMANENTE
  INFORME_EVENTO
  OTROS_ANEXOS_LIQUIDACION
  FORMULARIO_OFICIAL
  CARTA_MINISTRO
  EXPEDIENTE_COMPLETO
  DOCUMENTO_PRELIMINAR
  OTRO
}

enum ProcessedMessageStatus {
  OK
  FAILED
}

enum TravelMatrixStatus {
  MATRIZ_REGISTRADA
  PENDIENTE_PAUTA_RI
  PAUTA_RI_DADA
  CONVERTIDO_A_CASO
  CANCELLED
}

enum TravelAuthorizationType {
  MEMORANDO_PRESIDENCIA
  CORREO_INSTRUCCION
  INSTRUCCION_DIRECTA_RI
  MATRIZ_PROGRAMADA_CONFIRMADA
  VIAJE_IMPREVISTO
  OTRO
}

enum TravelAuthorizationValidationStatus {
  PENDIENTE_VALIDACION_AMPARO
  VALIDADO_POR_AMPARO
  DEVUELTO_POR_AMPARO
  RECHAZADO_POR_AMPARO
}

enum AuthorizationEvidenceChannel {
  MEMORANDO_FORMAL
  CORREO_AMPARO
  CORREO_PRESIDENCIA
  CORREO_DIRECTOR_SECRETARIA
  INSTRUCCION_VERBAL_REGISTRADA
  WHATSAPP
  OTRO
}

enum MatrixRiskLevel {
  NORMAL
  ADVERTENCIA
  CRITICO
  FUERA_DE_PLAZO
}

enum DesignationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum DocumentRequirementStatus {
  PENDING
  GENERATED
  ENVIADO_COMO_ANEXO_INFORMATIVO
  PENDIENTE_USO_POST_VIAJE
  UPLOADED
  VALIDATED
  REJECTED
  WAIVED
}

enum DocumentSource {
  COLABORADOR
  STAFF_UPLOAD
  SHAREPOINT
  GENERATED
  EMAIL
}

enum ExternalDocumentStatus {
  ACTIVE
  PENDING_REVIEW
  EXPIRED
  IGNORED
}

enum GeneratedDocumentType {
  CORREO_DESIGNACION
  FORMULARIO_SOLICITUD_VIAJE
  CARTA_MINISTRO_ADMINISTRATIVO
  FORMULARIO_LIQUIDACION_INFORMATIVO
  FORMULARIO_LIQUIDACION
}

enum GeneratedDocumentStatus {
  DRAFT
  GENERATED
  ATTACHED
}

enum SignatureType {
  PRESENCIAL
  DIGITAL_JUSTIFICADA
}

enum NotificationType {
  CASE_CREATED
  AUTHORIZATION_RECEIVED
  DIRECT_INSTRUCTION_REGISTERED
  MEMO_UPLOADED
  PENDING_AMPARO_VALIDATION
  AMPARO_VALIDATED
  AMPARO_RETURNED
  AMPARO_REJECTED
  URGENT_TRAVEL_CREATED
  OUT_OF_MAPRE_DEADLINE
  DESIGNATION_READY
  COLLABORATOR_DOCUMENTS_REQUESTED
  DOCUMENTS_COMPLETE
  MAPRE_LETTER_GENERATED
  PROFILE_DOCUMENT_MISSING
  PROFILE_DOCUMENT_EXPIRED
  SHAREPOINT_SYNC_ERRORS
  TRAVELER_CHANGED
  CASE_DOCUMENTS_FROM_PROFILE_ATTACHED
  MATRIZ_CREATED
  MATRIX_CONVERTED_TO_CASE
  TRAVEL_WINDOW_30_DAYS
  RI_PAUTA_GIVEN
  DESIGNATION_SENT
  COLLABORATOR_ACCEPTED
  COLLABORATOR_REJECTED
  DOCUMENT_UPLOADED
  DOCUMENT_REJECTED
  EXPEDIENTE_COMPLETE
  SENT_TO_DESPACHO
  DESPACHO_RETURNED
  DESPACHO_APPROVED
  SENT_TO_CONSEJO
  EXPEDIENTE_SIGNED
  SIGNED_EXPEDIENTE_RECEIVED
  TRAVEL_COMPLETED
  LIQUIDATION_REQUESTED
  LIQUIDATION_APPROVED
  LIQUIDATION_RETURNED
  LIQUIDATION_WAIVED
  CASE_CLOSED
  CASE_CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdCases      Case[]             @relation("CaseCreator")
  assignedTasks     Task[]
  auditLogs         AuditLog[]
  processedMessages ProcessedMessage[]
  createdMatrixEntries TravelMatrixEntry[] @relation("MatrixCreator")
  responsibleMatrixEntries TravelMatrixEntry[] @relation("MatrixResponsible")
  pautaMatrixEntries TravelMatrixEntry[] @relation("MatrixPautaUser")
  uploadedDocuments Document[] @relation("DocumentUploader")
  validatedRequirements DocumentRequirement[] @relation("RequirementValidator")
  notifications Notification[]
  readReceipts ReadReceipt[]
  caseClosures CaseClosure[]
  registeredTravelAuthorizations TravelAuthorization[] @relation("AuthorizationRegistrar")

  @@index([email])
  @@index([roleId])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String[] // Array of permission strings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
  tasks Task[]
}

model Profile {
  id              String   @id @default(uuid())
  primaryEmail    String?  @unique // Normalized: lowercase(trim()) - nullable if only cedula
  fullName        String?
  cedula          String?  @unique // Unique when not null
  passportNumber  String?
  passportCountry String?
  passportExpirationDate DateTime?
  visaCountry     String?
  visaExpirationDate DateTime?
  sharePointFolderId String?
  sharePointFolderName String?
  sharePointLastSyncedAt DateTime?
  isIncompleteFromSharePoint Boolean @default(false)
  phone           String?
  cargo           String?
  departamento    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cases     Case[]
  documents Document[]
  externalDocuments ProfileExternalDocument[]
  auditLogs AuditLog[]
  matrixEntries TravelMatrixEntry[]

  @@index([primaryEmail])
  @@index([cedula])
  @@index([passportNumber])
  @@index([sharePointFolderId])
}

model Case {
  id                      String     @id @default(uuid())
  profileId               String
  profile                 Profile    @relation(fields: [profileId], references: [id])
  createdByUserId         String?
  createdBy               User?      @relation("CaseCreator", fields: [createdByUserId], references: [id])
  source                  CaseSource
  status                  CaseStatus @default(RECEIVED)
  destinoPais             String?
  destinoCiudad           String?
  fechaSalida             DateTime?
  fechaRetorno            DateTime?
  motivo                  String?
  evento                  String?
  institucionOrganizadora String?
  montoEstimado           Decimal?   @db.Decimal(15, 2)
  moneda                  String?    @default("USD")
  centroCosto             String?
  observaciones           String?    @db.Text
  clientGeneratedId       String?    @unique // For idempotency in public form
  contenidoRaw            String?    @db.Text
  matrixEntryId           String?    @unique
  matrixEntry             TravelMatrixEntry? @relation("MatrixCase", fields: [matrixEntryId], references: [id])
  currentWorkflowStep     WorkflowStep?
  priority                String?
  dueAt                   DateTime?
  expedienteCompleto      Boolean    @default(false)
  expedienteCompletedAt   DateTime?
  expedienteSentToDespachoAt DateTime?
  expedienteSentToConsejoAt DateTime?
  signedAt                DateTime?
  signatureType           SignatureType?
  signedBy                String?
  digitalSignatureJustification String? @db.Text
  closedAt                DateTime?
  closureComment          String?    @db.Text
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  tasks                Task[]
  documents            Document[]
  externalDocuments    ProfileExternalDocument[]
  auditLogs            AuditLog[]
  designations         Designation[]
  documentRequirements DocumentRequirement[]
  generatedDocuments   GeneratedDocument[]
  notifications        Notification[]
  readReceipts         ReadReceipt[]
  closures             CaseClosure[]
  travelAuthorization  TravelAuthorization?

  @@index([profileId])
  @@index([status])
  @@index([createdAt])
  @@index([clientGeneratedId])
  @@index([matrixEntryId])
  @@index([currentWorkflowStep])
}

model TravelAuthorization {
  id                       String                              @id @default(uuid())
  caseId                   String                              @unique
  case                     Case                                @relation(fields: [caseId], references: [id])
  type                     TravelAuthorizationType
  evidenceChannel          AuthorizationEvidenceChannel?
  authorizationDocumentId  String?
  authorizationDocumentUrl String?
  authorizationDocumentName String?
  sourceEmailMessageId     String?
  sourceEmailRaw           String?                             @db.Text
  authorizedBy             String
  registeredByUserId       String?
  registeredBy             User?                               @relation("AuthorizationRegistrar", fields: [registeredByUserId], references: [id])
  authorizedAt             DateTime?
  registeredAt             DateTime                            @default(now())
  justification            String                              @db.Text
  requiresAmparoValidation Boolean                             @default(true)
  validationStatus         TravelAuthorizationValidationStatus @default(PENDIENTE_VALIDACION_AMPARO)
  validationComment        String?                             @db.Text
  validatedByUserId        String?
  validatedAt              DateTime?
  isRecurringTravel        Boolean                             @default(false)
  isUnexpectedTravel       Boolean                             @default(false)
  isOutOfMapreDeadline     Boolean                             @default(false)
  mapreDeadline            DateTime?
  createdAt                DateTime                            @default(now())
  updatedAt                DateTime                            @updatedAt

  @@index([type])
  @@index([validationStatus])
  @@index([registeredByUserId])
  @@index([authorizedBy])
  @@index([isUnexpectedTravel])
  @@index([isOutOfMapreDeadline])
}

model Task {
  id             String       @id @default(uuid())
  caseId         String
  case           Case         @relation(fields: [caseId], references: [id])
  step           WorkflowStep
  assignedRoleId String?
  assignedRole   Role?        @relation(fields: [assignedRoleId], references: [id])
  assignedUserId String?
  assignedUser   User?        @relation(fields: [assignedUserId], references: [id])
  status         TaskStatus   @default(PENDING)
  dueAt          DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  completedAt    DateTime?
  comment        String?       @db.Text

  @@index([caseId])
  @@index([assignedUserId])
  @@index([assignedRoleId])
  @@index([status])
}

model Document {
  id                   String       @id @default(uuid())
  profileId            String?
  profile              Profile?     @relation(fields: [profileId], references: [id])
  caseId               String?
  case                 Case?        @relation(fields: [caseId], references: [id])
  matrixEntryId        String?
  matrixEntry          TravelMatrixEntry? @relation(fields: [matrixEntryId], references: [id])
  docType              DocumentType
  originalFilename     String
  mimeType             String
  sizeBytes            Int
  blobUrl              String
  blobPathname         String
  checksumSha256       String?
  isCurrent            Boolean      @default(true)
  status               DocumentRequirementStatus @default(UPLOADED)
  source               DocumentSource @default(STAFF_UPLOAD)
  sharePointDriveId    String?
  sharePointItemId     String?
  sharePointWebUrl     String?
  sharePointLastModified DateTime?
  sourceDocumentId     String?
  expirationDate       DateTime?
  visaCountry          String?
  uploadedByUserId     String?
  uploadedByUser       User?        @relation("DocumentUploader", fields: [uploadedByUserId], references: [id])
  uploadedByName       String?
  observations         String?      @db.Text
  sourceEmailMessageId String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  requirements         DocumentRequirement[]
  generatedDocuments   GeneratedDocument[]

  @@index([profileId])
  @@index([caseId])
  @@index([matrixEntryId])
  @@index([docType])
  @@index([status])
  @@index([source])
  @@index([sharePointDriveId, sharePointItemId])
}

model SharePointSyncConfig {
  id             String   @id @default(uuid())
  siteId         String?
  driveId        String?
  baseFolderId   String?
  baseFolderName String?
  lastSyncAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([siteId])
  @@index([driveId])
}

model ProfileExternalDocument {
  id                     String                 @id @default(uuid())
  profileId              String
  profile                Profile                @relation(fields: [profileId], references: [id])
  caseId                 String?
  case                   Case?                  @relation(fields: [caseId], references: [id])
  copiedDocumentId       String?
  source                 DocumentSource         @default(SHAREPOINT)
  sharePointSiteId       String?
  sharePointDriveId      String
  sharePointItemId       String
  sharePointWebUrl       String?
  sharePointLastModified DateTime?
  parentFolderId         String?
  parentFolderName       String?
  modifiedBy             String?
  originalFileName       String
  mimeType               String
  sizeBytes              Int
  documentType           DocumentType
  status                 ExternalDocumentStatus @default(ACTIVE)
  expirationDate         DateTime?
  visaCountry            String?
  syncedAt               DateTime               @default(now())
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@unique([sharePointDriveId, sharePointItemId])
  @@index([profileId])
  @@index([caseId])
  @@index([documentType])
  @@index([status])
  @@index([source])
}

model ProcessedMessage {
  id                String                 @id @default(uuid())
  internetMessageId String                 @unique
  graphMessageId    String?                @unique
  processedAt       DateTime               @default(now())
  status            ProcessedMessageStatus
  error             String?                @db.Text
  processedByUserId String?
  processedBy       User?                  @relation(fields: [processedByUserId], references: [id])

  @@index([internetMessageId])
  @@index([graphMessageId])
  @@index([processedAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  caseId      String?
  case        Case?    @relation(fields: [caseId], references: [id])
  profileId   String?
  profile     Profile? @relation(fields: [profileId], references: [id])
  action      String
  details     Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([caseId])
  @@index([profileId])
  @@index([action])
  @@index([createdAt])
}

model TravelMatrixEntry {
  id                       String             @id @default(uuid())
  eventName                String
  country                  String
  city                     String?
  eventStartDate           DateTime
  eventEndDate             DateTime?
  estimatedDepartureDate   DateTime?
  estimatedReturnDate      DateTime?
  collaboratorName         String?
  collaboratorEmail        String?
  collaboratorPosition     String?
  collaboratorArea         String?
  profileId                String?
  profile                  Profile?           @relation(fields: [profileId], references: [id])
  organizerInstitution     String?
  objective                String?            @db.Text
  perDiemType              String?
  observations             String?            @db.Text
  programadoEnMatriz       Boolean            @default(true)
  requiereAutorizacionPresidencia Boolean     @default(false)
  autorizacionRecibida     Boolean            @default(false)
  personaDesignadaConfirmada Boolean          @default(false)
  viajeRecurrente          Boolean            @default(false)
  viajeImprevisto          Boolean            @default(false)
  fechaLimiteMapre         DateTime?
  nivelRiesgo              MatrixRiskLevel     @default(NORMAL)
  status                   TravelMatrixStatus @default(MATRIZ_REGISTRADA)
  responsibleUserId        String?
  responsibleUser          User?              @relation("MatrixResponsible", fields: [responsibleUserId], references: [id])
  createdByUserId          String?
  createdByUser            User?              @relation("MatrixCreator", fields: [createdByUserId], references: [id])
  pautaGivenByUserId       String?
  pautaGivenByUser         User?              @relation("MatrixPautaUser", fields: [pautaGivenByUserId], references: [id])
  pautaGivenAt             DateTime?
  convertedCaseId          String?            @unique
  convertedCase            Case?              @relation("MatrixCase")
  documents                Document[]
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([status])
  @@index([eventStartDate])
  @@index([estimatedDepartureDate])
  @@index([country])
  @@index([collaboratorEmail])
  @@index([responsibleUserId])
}

model Designation {
  id                    String            @id @default(uuid())
  caseId                String
  case                  Case              @relation(fields: [caseId], references: [id])
  collaboratorName      String?
  collaboratorEmail     String
  collaboratorPosition  String?
  collaboratorArea      String?
  subject               String
  body                  String            @db.Text
  token                 String            @unique
  tokenExpiresAt        DateTime
  status                DesignationStatus @default(DRAFT)
  sentAt                DateTime?
  sentByUserId          String?
  respondedAt           DateTime?
  acceptedTerms         Boolean           @default(false)
  confirmedAvailability Boolean           @default(false)
  responseComment       String?           @db.Text
  rejectionReason       String?           @db.Text
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([caseId])
  @@index([collaboratorEmail])
  @@index([status])
  @@index([tokenExpiresAt])
}

model DocumentRequirement {
  id                    String                    @id @default(uuid())
  caseId                String
  case                  Case                      @relation(fields: [caseId], references: [id])
  docType               DocumentType
  label                 String
  required              Boolean                   @default(true)
  status                DocumentRequirementStatus @default(PENDING)
  documentId            String?
  document              Document?                 @relation(fields: [documentId], references: [id])
  uploadedByUserId      String?
  uploadedByName        String?
  uploadedAt            DateTime?
  validatedByUserId     String?
  validatedByUser       User?                     @relation("RequirementValidator", fields: [validatedByUserId], references: [id])
  validatedAt           DateTime?
  observations          String?                   @db.Text
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@unique([caseId, docType])
  @@index([caseId])
  @@index([status])
  @@index([docType])
}

model GeneratedDocument {
  id              String                  @id @default(uuid())
  caseId          String
  case            Case                    @relation(fields: [caseId], references: [id])
  type            GeneratedDocumentType
  title           String
  draftContent    String                  @db.Text
  status          GeneratedDocumentStatus @default(DRAFT)
  documentId      String?
  document        Document?               @relation(fields: [documentId], references: [id])
  generatedAt     DateTime?
  generatedByUserId String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([caseId, type])
  @@index([caseId])
  @@index([type])
  @@index([status])
}

model ReadReceipt {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  readAt    DateTime @default(now())

  @@unique([userId, caseId])
  @@index([userId])
  @@index([caseId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String?
  user      User?            @relation(fields: [userId], references: [id])
  caseId    String?
  case      Case?            @relation(fields: [caseId], references: [id])
  type      NotificationType
  title     String
  message   String           @db.Text
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([caseId])
  @@index([type])
  @@index([readAt])
  @@index([createdAt])
}

model CaseClosure {
  id             String   @id @default(uuid())
  caseId         String
  case           Case     @relation(fields: [caseId], references: [id])
  closedByUserId String
  closedByUser   User     @relation(fields: [closedByUserId], references: [id])
  comment        String   @db.Text
  closedAt       DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([caseId])
  @@index([closedByUserId])
  @@index([closedAt])
}
