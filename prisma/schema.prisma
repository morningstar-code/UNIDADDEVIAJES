// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  RI_DIRECTORA
  VIAJES_ANALISTA
  DESPACHO
  CONSEJO_DIRECTIVO
  JEFE
  FINANZAS
  RRHH
}

enum CaseSource {
  EMAIL_AUTOMATION
  MANUAL
  PUBLIC_FORM
  MATRIZ
  DESIGNATION
}

enum CaseStatus {
  MATRIZ_REGISTRADA
  PENDIENTE_PAUTA_RI
  PAUTA_RI_DADA
  DESIGNACION_GENERADA
  DESIGNACION_ENVIADA
  PENDIENTE_ACEPTACION_COLABORADOR
  COLABORADOR_ACEPTO
  COLABORADOR_RECHAZO
  PENDIENTE_DOCUMENTOS
  DOCUMENTOS_EN_REVISION
  DOCUMENTOS_COMPLETOS
  FORMULARIO_EN_ELABORACION
  CARTA_EN_ELABORACION
  EXPEDIENTE_ARMADO
  DESPACHO_REVIEW
  CONSEJO_DIRECTIVO_FIRMA
  EXPEDIENTE_FIRMADO_RECIBIDO
  COORDINACION_ADMINISTRATIVA
  CANCELLED
  FIRMA_DIGITAL_PENDIENTE_JUSTIFICACION
  RECEIVED
  DOCS_VALIDATION
  TECH_REVIEW
  MANAGER_APPROVAL
  FINANCE_APPROVAL
  HR_APPROVAL
  APPROVED
  REJECTED
  NEEDS_INFO
  CLOSED
}

enum WorkflowStep {
  PENDIENTE_PAUTA_RI
  DESIGNATION
  COLLABORATOR_ACCEPTANCE
  DOCUMENT_COLLECTION
  DOCUMENT_REVIEW
  FORMULARIO_SOLICITUD
  CARTA_MINISTRO
  EXPEDIENTE_REVIEW
  DESPACHO_REVIEW
  CONSEJO_DIRECTIVO_FIRMA
  EXPEDIENTE_FIRMADO_RECEIPT
  COORDINACION_ADMINISTRATIVA
  CLOSURE
  DOCS_VALIDATION
  TECH_REVIEW
  MANAGER_APPROVAL
  FINANCE_APPROVAL
  HR_APPROVAL
}

enum TaskStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum DocumentType {
  CEDULA
  PASAPORTE
  VISA
  FOTO
  CARTA_INVITACION
  INVITACION
  AGENDA
  TICKET
  MEMO_APROBACION
  FORMULARIO_SOLICITUD_VIAJE
  CARTA_MINISTRO_ADMINISTRATIVO
  EXPEDIENTE_FIRMADO
  JUSTIFICACION_FIRMA_DIGITAL
  FORMULARIO_OFICIAL
  CARTA_MINISTRO
  EXPEDIENTE_COMPLETO
  DOCUMENTO_PRELIMINAR
  OTRO
}

enum ProcessedMessageStatus {
  OK
  FAILED
}

enum TravelMatrixStatus {
  MATRIZ_REGISTRADA
  PENDIENTE_PAUTA_RI
  PAUTA_RI_DADA
  CONVERTIDO_A_CASO
  CANCELLED
}

enum DesignationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum DocumentRequirementStatus {
  PENDING
  UPLOADED
  VALIDATED
  REJECTED
  WAIVED
}

enum GeneratedDocumentType {
  FORMULARIO_SOLICITUD_VIAJE
  CARTA_MINISTRO_ADMINISTRATIVO
}

enum GeneratedDocumentStatus {
  DRAFT
  GENERATED
  ATTACHED
}

enum SignatureType {
  PRESENCIAL
  DIGITAL_JUSTIFICADA
}

enum NotificationType {
  MATRIZ_CREATED
  TRAVEL_WINDOW_30_DAYS
  RI_PAUTA_GIVEN
  DESIGNATION_SENT
  COLLABORATOR_ACCEPTED
  COLLABORATOR_REJECTED
  DOCUMENT_UPLOADED
  DOCUMENT_REJECTED
  EXPEDIENTE_COMPLETE
  SENT_TO_DESPACHO
  SENT_TO_CONSEJO
  EXPEDIENTE_SIGNED
  CASE_CLOSED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdCases      Case[]             @relation("CaseCreator")
  assignedTasks     Task[]
  auditLogs         AuditLog[]
  processedMessages ProcessedMessage[]
  createdMatrixEntries TravelMatrixEntry[] @relation("MatrixCreator")
  responsibleMatrixEntries TravelMatrixEntry[] @relation("MatrixResponsible")
  pautaMatrixEntries TravelMatrixEntry[] @relation("MatrixPautaUser")
  uploadedDocuments Document[] @relation("DocumentUploader")
  validatedRequirements DocumentRequirement[] @relation("RequirementValidator")
  notifications Notification[]
  readReceipts ReadReceipt[]
  caseClosures CaseClosure[]

  @@index([email])
  @@index([roleId])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String[] // Array of permission strings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
  tasks Task[]
}

model Profile {
  id              String   @id @default(uuid())
  primaryEmail    String?  @unique // Normalized: lowercase(trim()) - nullable if only cedula
  fullName        String?
  cedula          String?  @unique // Unique when not null
  passportNumber  String?
  passportCountry String?
  phone           String?
  cargo           String?
  departamento    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cases     Case[]
  documents Document[]
  auditLogs AuditLog[]
  matrixEntries TravelMatrixEntry[]

  @@index([primaryEmail])
  @@index([cedula])
  @@index([passportNumber])
}

model Case {
  id                      String     @id @default(uuid())
  profileId               String
  profile                 Profile    @relation(fields: [profileId], references: [id])
  createdByUserId         String?
  createdBy               User?      @relation("CaseCreator", fields: [createdByUserId], references: [id])
  source                  CaseSource
  status                  CaseStatus @default(RECEIVED)
  destinoPais             String?
  destinoCiudad           String?
  fechaSalida             DateTime?
  fechaRetorno            DateTime?
  motivo                  String?
  evento                  String?
  institucionOrganizadora String?
  montoEstimado           Decimal?   @db.Decimal(15, 2)
  moneda                  String?    @default("USD")
  centroCosto             String?
  observaciones           String?    @db.Text
  clientGeneratedId       String?    @unique // For idempotency in public form
  contenidoRaw            String?    @db.Text
  matrixEntryId           String?    @unique
  matrixEntry             TravelMatrixEntry? @relation("MatrixCase", fields: [matrixEntryId], references: [id])
  currentWorkflowStep     WorkflowStep?
  priority                String?
  dueAt                   DateTime?
  expedienteCompleto      Boolean    @default(false)
  expedienteCompletedAt   DateTime?
  expedienteSentToDespachoAt DateTime?
  expedienteSentToConsejoAt DateTime?
  signedAt                DateTime?
  signatureType           SignatureType?
  signedBy                String?
  digitalSignatureJustification String? @db.Text
  closedAt                DateTime?
  closureComment          String?    @db.Text
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  tasks                Task[]
  documents            Document[]
  auditLogs            AuditLog[]
  designations         Designation[]
  documentRequirements DocumentRequirement[]
  generatedDocuments   GeneratedDocument[]
  notifications        Notification[]
  readReceipts         ReadReceipt[]
  closures             CaseClosure[]

  @@index([profileId])
  @@index([status])
  @@index([createdAt])
  @@index([clientGeneratedId])
  @@index([matrixEntryId])
  @@index([currentWorkflowStep])
}

model Task {
  id             String       @id @default(uuid())
  caseId         String
  case           Case         @relation(fields: [caseId], references: [id])
  step           WorkflowStep
  assignedRoleId String?
  assignedRole   Role?        @relation(fields: [assignedRoleId], references: [id])
  assignedUserId String?
  assignedUser   User?        @relation(fields: [assignedUserId], references: [id])
  status         TaskStatus   @default(PENDING)
  dueAt          DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  completedAt    DateTime?
  comment        String?       @db.Text

  @@index([caseId])
  @@index([assignedUserId])
  @@index([assignedRoleId])
  @@index([status])
}

model Document {
  id                   String       @id @default(uuid())
  profileId            String?
  profile              Profile?     @relation(fields: [profileId], references: [id])
  caseId               String?
  case                 Case?        @relation(fields: [caseId], references: [id])
  matrixEntryId        String?
  matrixEntry          TravelMatrixEntry? @relation(fields: [matrixEntryId], references: [id])
  docType              DocumentType
  originalFilename     String
  mimeType             String
  sizeBytes            Int
  blobUrl              String
  blobPathname         String
  checksumSha256       String?
  isCurrent            Boolean      @default(true)
  status               DocumentRequirementStatus @default(UPLOADED)
  uploadedByUserId     String?
  uploadedByUser       User?        @relation("DocumentUploader", fields: [uploadedByUserId], references: [id])
  uploadedByName       String?
  observations         String?      @db.Text
  sourceEmailMessageId String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  requirements         DocumentRequirement[]
  generatedDocuments   GeneratedDocument[]

  @@index([profileId])
  @@index([caseId])
  @@index([matrixEntryId])
  @@index([docType])
  @@index([status])
}

model ProcessedMessage {
  id                String                 @id @default(uuid())
  internetMessageId String                 @unique
  graphMessageId    String?                @unique
  processedAt       DateTime               @default(now())
  status            ProcessedMessageStatus
  error             String?                @db.Text
  processedByUserId String?
  processedBy       User?                  @relation(fields: [processedByUserId], references: [id])

  @@index([internetMessageId])
  @@index([graphMessageId])
  @@index([processedAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  caseId      String?
  case        Case?    @relation(fields: [caseId], references: [id])
  profileId   String?
  profile     Profile? @relation(fields: [profileId], references: [id])
  action      String
  details     Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([caseId])
  @@index([profileId])
  @@index([action])
  @@index([createdAt])
}

model TravelMatrixEntry {
  id                       String             @id @default(uuid())
  eventName                String
  country                  String
  city                     String?
  eventStartDate           DateTime
  eventEndDate             DateTime?
  estimatedDepartureDate   DateTime?
  estimatedReturnDate      DateTime?
  collaboratorName         String?
  collaboratorEmail        String?
  collaboratorPosition     String?
  collaboratorArea         String?
  profileId                String?
  profile                  Profile?           @relation(fields: [profileId], references: [id])
  organizerInstitution     String?
  objective                String?            @db.Text
  perDiemType              String?
  observations             String?            @db.Text
  status                   TravelMatrixStatus @default(MATRIZ_REGISTRADA)
  responsibleUserId        String?
  responsibleUser          User?              @relation("MatrixResponsible", fields: [responsibleUserId], references: [id])
  createdByUserId          String?
  createdByUser            User?              @relation("MatrixCreator", fields: [createdByUserId], references: [id])
  pautaGivenByUserId       String?
  pautaGivenByUser         User?              @relation("MatrixPautaUser", fields: [pautaGivenByUserId], references: [id])
  pautaGivenAt             DateTime?
  convertedCaseId          String?            @unique
  convertedCase            Case?              @relation("MatrixCase")
  documents                Document[]
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([status])
  @@index([eventStartDate])
  @@index([estimatedDepartureDate])
  @@index([country])
  @@index([collaboratorEmail])
  @@index([responsibleUserId])
}

model Designation {
  id                    String            @id @default(uuid())
  caseId                String
  case                  Case              @relation(fields: [caseId], references: [id])
  collaboratorName      String?
  collaboratorEmail     String
  collaboratorPosition  String?
  collaboratorArea      String?
  subject               String
  body                  String            @db.Text
  token                 String            @unique
  tokenExpiresAt        DateTime
  status                DesignationStatus @default(DRAFT)
  sentAt                DateTime?
  sentByUserId          String?
  respondedAt           DateTime?
  acceptedTerms         Boolean           @default(false)
  confirmedAvailability Boolean           @default(false)
  responseComment       String?           @db.Text
  rejectionReason       String?           @db.Text
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([caseId])
  @@index([collaboratorEmail])
  @@index([status])
  @@index([tokenExpiresAt])
}

model DocumentRequirement {
  id                    String                    @id @default(uuid())
  caseId                String
  case                  Case                      @relation(fields: [caseId], references: [id])
  docType               DocumentType
  label                 String
  required              Boolean                   @default(true)
  status                DocumentRequirementStatus @default(PENDING)
  documentId            String?
  document              Document?                 @relation(fields: [documentId], references: [id])
  uploadedByUserId      String?
  uploadedByName        String?
  uploadedAt            DateTime?
  validatedByUserId     String?
  validatedByUser       User?                     @relation("RequirementValidator", fields: [validatedByUserId], references: [id])
  validatedAt           DateTime?
  observations          String?                   @db.Text
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@unique([caseId, docType])
  @@index([caseId])
  @@index([status])
  @@index([docType])
}

model GeneratedDocument {
  id              String                  @id @default(uuid())
  caseId          String
  case            Case                    @relation(fields: [caseId], references: [id])
  type            GeneratedDocumentType
  title           String
  draftContent    String                  @db.Text
  status          GeneratedDocumentStatus @default(DRAFT)
  documentId      String?
  document        Document?               @relation(fields: [documentId], references: [id])
  generatedAt     DateTime?
  generatedByUserId String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([caseId, type])
  @@index([caseId])
  @@index([type])
  @@index([status])
}

model ReadReceipt {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  readAt    DateTime @default(now())

  @@unique([userId, caseId])
  @@index([userId])
  @@index([caseId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String?
  user      User?            @relation(fields: [userId], references: [id])
  caseId    String?
  case      Case?            @relation(fields: [caseId], references: [id])
  type      NotificationType
  title     String
  message   String           @db.Text
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([caseId])
  @@index([type])
  @@index([readAt])
  @@index([createdAt])
}

model CaseClosure {
  id             String   @id @default(uuid())
  caseId         String
  case           Case     @relation(fields: [caseId], references: [id])
  closedByUserId String
  closedByUser   User     @relation(fields: [closedByUserId], references: [id])
  comment        String   @db.Text
  closedAt       DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([caseId])
  @@index([closedByUserId])
  @@index([closedAt])
}
